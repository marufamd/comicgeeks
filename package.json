{
	"name": "comicgeeks",
	"version": "1.2.0",
	"description": "A NodeJS module to get data from League of Comic Geeks",
	"main": "dist/index.js",
	"module": "esm/index.mjs",
	"typings": "typings/index.d.ts",
	"scripts": {
		"prepublishOnly": "npm run build",
		"build": "rimraf ./dist ./typings && tsc",
		"docs": "rimraf ./docs && typedoc",
		"test": "vitest run src"
	},
	"files": [
		"dist",
		"esm",
		"typings"
	],
	"keywords": [
		"comic",
		"comicbook",
		"comic geeks",
		"comicgeeks",
		"leagueofcomicgeeks",
		"league of comic geeks"
	],
	"author": "marufamd",
	"repository": "https://github.com/marufamd/comicgeeks",
	"homepage": "https://github.com/marufamd/comicgeeks#readme",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^25.6.2",
		"@typescript-eslint/eslint-plugin": "^4.14.2",
		"@typescript-eslint/parser": "^4.14.2",
		"eslint": "^7.19.0",
		"eslint-config-marine": "^8.1.0",
		"rimraf": "^6.1.3",
		"typedoc": "^0.28.19",
		"typescript": "^6.0.3",
		"vitest": "^4.1.5"
	},
	"dependencies": {
		"cheerio": "^1.2.0",
		"impit": "^0.14.0"
	}
}
