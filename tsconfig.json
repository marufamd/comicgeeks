{
    "compilerOptions": {
        "rootDir": "src",
        "outDir": "dist",
        "lib": [
            "ES2020",
            "ESNext"
        ],
        "module": "Node16",
        "target": "ES2017",
        "declaration": true,
        "declarationDir": "typings",
        "strict": true,
        "alwaysStrict": true,
        "strictNullChecks": false,
        "esModuleInterop": true,
        "moduleResolution": "node16",
        "removeComments": false,
        "preserveConstEnums": true,
        "pretty": true,
        "resolveJsonModule": true,
        "skipLibCheck": true
    }
}